# =========================================
#  simpomo (.gitignore)
#  Tauri v2 (Rust) + Svelte (Vite/TypeScript)
# =========================================

# --- Node / Frontend ---
node_modules/
.pnp
.pnp.js
.yarn/install-state.gz
dist/
build/
out/
.svelte-kit/
.vite/
.cache/
.parcel-cache/
*.tsbuildinfo

# --- Rust / Tauri backend (src-tauri) ---
src-tauri/target/
**/*.rs.bk
*.pdb
Cargo.lock.bak
# Tauri mobile / generated artifacts
src-tauri/gen/

# --- Logs ---
*.log
npm-debug.log*
pnpm-debug.log*
yarn-debug.log*
yarn-error.log*

# --- Testing & coverage ---
coverage/
.nyc_output/

# --- Secrets / signing keys (NEVER commit — public repo) ---
.env
.env.*
.env.local
.env.*.local
*.pem
*.key
# Tauri code-signing / updater private keys
*.tauri.key
*.tauri.key.pub
tauri-private.key

# --- Editor / OS ---
.vscode/
.idea/
.DS_Store
Thumbs.db

# --- Claude / project-init local scaffolding (keep out of public repo) ---
.claude/
